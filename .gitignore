# secrets
.env
.env.*

# local remote-host metadata (live endpoints and machine-specific SSH settings)
.remote/

# data & model artifacts (never in git; synced via scripts/remote/sync.sh)
# root-anchored: must not swallow source packages like src/forge/data/
# exception: manifest.json files are small provenance receipts and ARE tracked
/data/**
!/data/**/
!/data/**/manifest.json
# smoke fixtures are small deterministic files CI depends on — track the whole tree
!/data/smoke/**
/checkpoints/
*.gguf
*.safetensors
*.onnx
*.bin
wheels/
*.whl

# python
.venv/
.venv-phase4/
.uv-cache-phase4/
.uv-cache-phase7/
.tmp-phase4/
.tmp-phase5/
.tmp-phase7_1/
.tmp-phase6-smoke/
.cache-phase5/
.cache/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# c++
gateway/build/
gateway/out/
gateway/compile_commands.json
gateway/profile/
demo/dist/
demo/.dist-phase6.tmp/
/results/phase7_1/runtime/

# os / editor
.DS_Store
.idea/
.vscode/

# scratch (results/runs.jsonl and reports ARE tracked — do not add results/ here)
tmp/
